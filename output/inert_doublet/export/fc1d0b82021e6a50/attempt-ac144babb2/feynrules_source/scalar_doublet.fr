pmDO0003n1 == {ParameterType -> Internal, Value -> -1.266813137468242, ComplexParameter -> False, InteractionOrder -> {{NP, 1}, {QED, 2}}, Description -> "pmDO0003n1"},
pmDO0003n2 == {ParameterType -> Internal, Value -> 0.633406568734121, ComplexParameter -> False, InteractionOrder -> {{NP, 1}, {QED, 2}}, Description -> "pmDO0003n2"},
