S[304] == {ClassName -> pmD, SelfConjugate -> False, Unphysical -> True, Indices -> {Index[SU2D]}, QuantumNumbers -> {Y -> 1/2}, Definitions -> {pmD[1] -> pmDC/Sqrt[pmDK], pmD[2] -> ((pmDR11*pmDN1)+I*(pmDR22*pmDN2))/Sqrt[2]}}
};
