(* Doublet potentials use sorted products of dagger-undagger bilinears; Yukawas use row-major Q/L then singlet generation order. *)
LDoublet := Block[{mu,ii,jj,sp,cc,i1,i2}, ExpandIndices[pmDO0002n1*(pmDbar[i1]*pmD[i1]) + pmDO0003n1*(Phibar[i1]*Phi[i1]*pmDbar[i2]*pmD[i2]) + pmDO0003n2*(Phibar[i1]*pmD[i1]*pmDbar[i2]*Phi[i2]) + (pmDO0006n1*(pmDbar[i1]*Phi[i1]*pmDbar[i2]*Phi[i2])+HC[pmDO0006n1*(pmDbar[i1]*Phi[i1]*pmDbar[i2]*Phi[i2])]) + pmDO0010n1*(pmDbar[i1]*pmD[i1]*pmDbar[i2]*pmD[i2]) + pmDO0012n1*(DC[pmDbar[ii],mu]*DC[pmD[ii],mu]), FlavorExpand -> {SU2D,SU2W}]] /. {G0|GP|GPbar -> 0};
