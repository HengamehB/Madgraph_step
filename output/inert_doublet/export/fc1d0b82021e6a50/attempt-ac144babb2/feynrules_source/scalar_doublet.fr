S[301] == {ClassName -> pmDC, SelfConjugate -> False,
              AntiParticleName -> "x-", QuantumNumbers -> {Q -> 1}, Mass -> {pmDM1,220},
              Width -> {pmDW1,0}, ParticleName -> "x+", PDG -> 9300001,
